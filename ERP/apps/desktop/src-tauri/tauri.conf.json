{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../web/dist"
  },
  "package": {
    "productName": "Coffeeshop ERP",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:*", "https://**"]
      },
      "notification": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "kz.coffeeshop.erp",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": ["binaries/erp-server"],
      "resources": [],
      "longDescription": "Coffee Shop ERP — offline-first POS and management system",
      "shortDescription": "Coffeeshop ERP",
      "category": "Business"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Coffeeshop ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "sidecar": {
      "args": ["--env", "prod", "--port", "7171"],
      "name": "binaries/erp-server"
    }
  }
}
